# Quorum configuration — copy to .env and fill in.

# Required: any OpenAI-compatible key
OPENAI_API_KEY=

# Optional: point at a proxy or local endpoint, swap models
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# REQUEST_TIMEOUT_MS=60000
# MAX_REPAIR_ATTEMPTS=1

# Per-role model overrides (Phase 1+)
# RESEARCHER_MODEL=
# CHECKER_MODEL=

# Web search (Phase 1)
# TAVILY_API_KEY=

# Phase 7 extensions
# SKEPTIC=on                 # skeptic agent challenges supported claims before synthesis
# PARALLEL_RESEARCH=off      # one researcher per sub-question (more LLM calls per run)
# RESEARCH_CONCURRENCY=3     # parallel fan-out width when PARALLEL_RESEARCH=on
